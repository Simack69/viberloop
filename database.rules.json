{
  "rules": {
    "transactions": {
      ".read": true,
      ".write": true,
      "$transactionId": {
        ".validate": "newData.hasChildren(['customer', 'transactionDate', 'purchaseOrder', 'role', 'location', 'hash', 'time', 'photoUrl']) && newData.child('timestamp').exists()"
      }
    }
  }
}
